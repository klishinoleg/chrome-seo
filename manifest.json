{
  "manifest_version": 3,
  "name": "SEO / инспектор",
  "version": "0.1.2",
  "description": "META, ключевые слова, микроразметка и внешние ссылки текущей страницы.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEO / инспектор"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.ru/search*",
        "https://yandex.ru/search*",
        "https://yandex.com/search*"
      ],
      "js": [
        "serp.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
