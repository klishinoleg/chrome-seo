{
  "manifest_version": 3,
  "name": "SEO / инспектор",
  "version": "0.1.9",
  "description": "META, ключевые слова, микроразметка и внешние ссылки текущей страницы.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEO / инспектор"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://google.com/*",
        "https://www.google.com/*",
        "https://google.ru/*",
        "https://www.google.ru/*",
        "https://yandex.com/*",
        "https://www.yandex.com/*",
        "https://yandex.ru/*",
        "https://www.yandex.ru/*"
      ],
      "js": [
        "serp-parser.js",
        "serp.js",
        "query-picker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wordstat.yandex.ru/*"
      ],
      "js": [
        "query-picker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://openpagerank.keywordseverywhere.com/*",
    "https://api.keywordseverywhere.com/*",
    "https://google.com/*",
    "https://www.google.com/*",
    "https://google.ru/*",
    "https://www.google.ru/*",
    "https://yandex.com/*",
    "https://www.yandex.com/*",
    "https://yandex.ru/*",
    "https://www.yandex.ru/*",
    "https://wordstat.yandex.ru/*"
  ]
}
